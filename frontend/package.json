{
  "name": "autotraq-frontend",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "VITE_API_URL=https://backend-production-b163.up.railway.app npm run build && electron-builder --win --x64",
    "desktop": "VITE_API_URL=https://backend-production-b163.up.railway.app npm run build && electron .",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx"
  },
  "build": {
    "appId": "org.cs490unco.autotraq",
    "productName": "AutoTraq",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "AutoTraq-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "AutoTraq-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.563.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@napi-rs/wasm-runtime": "^1.1.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tybys/wasm-util": "^0.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.10"
  }
}
